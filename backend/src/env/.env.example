# ===================================
# PLANTILLA DE VARIABLES DE ENTORNO
# ===================================
# Copia este archivo como .env y completa con tus valores reales
# NUNCA subas el archivo .env real a Git

# Base de datos MySQL
DB_HOST=localhost
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_password_mysql
DB_PORT=3306
DB_DATABASE=pollos

# JWT Configuration
# Genera un secreto seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
AUTH_SECRET=tu_secreto_jwt_super_seguro_aqui_minimo_256_bits
AUTH_EXPIRE=20h

# Puerto del servidor
PORT=3000
