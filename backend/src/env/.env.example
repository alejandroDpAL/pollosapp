# Archivo de ejemplo de variables de entorno
# Base de datos MySQL
DB_HOST=localhost
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_password_mysql
DB_PORT=3306
DB_DATABASE=pollos

# JWT Configuration - Tokens Separados para Seguridad
# Genera secretos seguros con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# Access Token: Usado para acceder a APIs (corta duración recomendada: 15m-1h)
ACCESS_TOKEN_SECRET=genera_un_secreto_seguro_de_512_bits_aqui
ACCESS_TOKEN_EXPIRE=15m

# Refresh Token: Usado solo para renovar access token (larga duración: 7d-30d)
REFRESH_TOKEN_SECRET=genera_otro_secreto_diferente_de_512_bits_aqui
REFRESH_TOKEN_EXPIRE=7d

# Puerto del servidor
PORT=3000
